--recurse=yes
--tag-relative=yes
--exclude=.svn
--exclude=.git
--exclude=node_modules
--exclude=ckeditor
--exclude=ckfinder
--exclude=cache
--exclude=*.js
--exclude=*.md
--exclude=*.xsl
--exclude=*.xml
--exclude=*.f
--exclude=*.f90
--exclude=*.rst
--exclude=*.h
--exclude=*.ini
--exclude=*.css
--exclude=*.json
--exclude=*Test.php
--exclude=composer.phar
--langmap=php:.php
--fields=+aimlS
--PHP-kinds=+cfivt
--python-kinds=-i
